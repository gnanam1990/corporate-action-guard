# Corporate Action Guard — local environment template.
# Copy to .env and fill in. NEVER commit a filled .env.
#
# Anything prefixed NEXT_PUBLIC_ is compiled into the browser bundle.
# No server secret may ever use that prefix (enforced by packages/config and by a
# bundle scan in `pnpm --filter @cag/web build` verification).

NODE_ENV=development

# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql://guard:guard@localhost:55432/guard

# --- xStocks production API ----------------------------------------------
# Verified 2026-09-03: the /api/v2 path is required; the bare host returns 404.
XSTOCKS_API_BASE_URL=https://api.xstocks.fi/api/v2

# --- X Layer -------------------------------------------------------------
# Mainnet is READ ONLY. There is no signing code path for chain 196.
XLAYER_MAINNET_RPC_URL=
XLAYER_TESTNET_RPC_URL=
XLAYER_MAINNET_CHAIN_ID=196
XLAYER_TESTNET_CHAIN_ID=1952

# --- Service URLs --------------------------------------------------------
API_PUBLIC_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Operator authentication ---------------------------------------------
# Hash only. Raw API keys are never stored or logged.
OPERATOR_API_KEY_HASH=

# Development-only API keys, hashed at startup and never retained in plaintext.
# Format: keyId|principal|scope[,scope]|rawKey   (entries separated by ';')
# Fields use '|' because scope names contain a colon.
# Quote the value: the '|' separators are shell pipes when the file is `source`d.
# DEV_API_KEYS='integ001|integrator-a|integrator:preflight|cag_integ001_0123456789abcdef0123456789abcdef'

# --- Receipt signer (testnet only) ---------------------------------------
# Temporary hackathon mechanism. Production requires HSM/KMS or threshold
# signing plus an auditable rotation procedure (ADR 0002).
RECEIPT_SIGNER_PRIVATE_KEY=
RECEIPT_SIGNER_ADDRESS=

# --- Deployed testnet contracts (chain 1952) ------------------------------
# Populated only from a verified deployment artifact; never hand-written.
GUARD_ADAPTER_TESTNET_ADDRESS=
PROTECTED_VAULT_TESTNET_ADDRESS=
FIXTURE_ASSET_TESTNET_ADDRESS=
