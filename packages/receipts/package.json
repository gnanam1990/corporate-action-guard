{
  "name": "@cag/receipts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EIP-712 operation digest, receipt signer, and verifier.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "vectors"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "vectors": "tsc --build && node dist/write-vectors.js"
  },
  "dependencies": {
    "@cag/config": "workspace:*",
    "@cag/domain": "workspace:*",
    "viem": "^2.56.3"
  }
}
