{
  "openapi": "3.1.0",
  "info": {
    "title": "Corporate Action Guard API",
    "version": "1.0.0",
    "description": "Fail-closed preflight authorization for integrations acting on xStocks corporate-action state. A receipt is issued only for an ALLOW decision. The guard is enforceable only for paths that route through ActionGuardAdapter; a direct ERC-20 transfer bypasses it. X Layer mainnet is read-only.",
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Local development"
    }
  ],
  "tags": [
    {
      "name": "health",
      "description": "Liveness and readiness"
    },
    {
      "name": "evidence",
      "description": "Public read-only evidence"
    },
    {
      "name": "preflight",
      "description": "Operation authorization"
    },
    {
      "name": "operator",
      "description": "Incident review"
    }
  ],
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Format cag_<keyId>_<secret>. Only the sha256 hash is stored server-side; the raw key is never logged."
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "required": ["type", "title", "status"],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Health": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ready", "not-ready", "live"]
          },
          "components": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "ok": {
                  "type": "boolean"
                },
                "detail": {
                  "type": "string"
                }
              },
              "required": ["name", "ok", "detail"]
            }
          },
          "uptimeSeconds": {
            "type": "number"
          }
        },
        "required": ["status"]
      },
      "AssetFilter": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "limit": {
            "default": 25,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "type": "string",
            "maxLength": 512
          },
          "lifecycleState": {
            "type": "string",
            "enum": [
              "NORMAL",
              "PENDING",
              "GUARD_WINDOW",
              "APPLIED",
              "RECONCILED",
              "MISMATCH",
              "MANUAL_REVIEW",
              "RECOVERED"
            ]
          },
          "canonicality": {
            "type": "string",
            "enum": ["PASS", "FAIL", "UNKNOWN"]
          },
          "staleEvidence": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "enum": ["true", "false"]
              }
            ]
          },
          "search": {
            "type": "string",
            "maxLength": 64
          }
        },
        "additionalProperties": false
      },
      "TimelineQuery": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "upToEventId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "limit": {
            "default": 200,
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          }
        },
        "additionalProperties": false
      },
      "PreflightRequest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "chainId": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "assetId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "target": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "asset": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "wrapper": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "actionType": {
            "type": "string",
            "enum": ["DEPOSIT", "WITHDRAW", "TRANSFER", "REDEEM"]
          },
          "caller": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "recipient": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "amount": {
            "type": "string",
            "pattern": "^[0-9]{1,78}$"
          },
          "expectedMultiplierNonce": {
            "type": "string",
            "pattern": "^[0-9]{1,78}$"
          }
        },
        "required": [
          "chainId",
          "assetId",
          "target",
          "asset",
          "wrapper",
          "actionType",
          "caller",
          "recipient",
          "amount",
          "expectedMultiplierNonce"
        ],
        "additionalProperties": false
      },
      "PreflightResponse": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "decision": {
                "type": "string",
                "const": "ALLOW"
              },
              "requestId": {
                "type": "string"
              },
              "evaluatedAt": {
                "type": "string"
              },
              "reasonCodes": {
                "type": "array",
                "prefixItems": [],
                "items": false,
                "maxItems": 0
              },
              "evidence": {
                "type": "object",
                "properties": {
                  "apiEvidenceAgeMs": {
                    "type": ["number", "null"]
                  },
                  "chainEvidenceAgeMs": {
                    "type": ["number", "null"]
                  },
                  "evidenceIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "blockNumber": {
                    "type": ["string", "null"]
                  },
                  "blockHash": {
                    "type": ["string", "null"]
                  }
                },
                "required": [
                  "apiEvidenceAgeMs",
                  "chainEvidenceAgeMs",
                  "evidenceIds",
                  "blockNumber",
                  "blockHash"
                ]
              },
              "operationDigest": {
                "type": "string"
              },
              "receipt": {
                "type": "object",
                "properties": {
                  "schemaVersion": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "receiptId": {
                    "type": "string"
                  },
                  "caller": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{40}$"
                  },
                  "target": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{40}$"
                  },
                  "asset": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{40}$"
                  },
                  "wrapper": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{40}$"
                  },
                  "actionType": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 255
                  },
                  "recipient": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{40}$"
                  },
                  "amount": {
                    "type": "string",
                    "pattern": "^[0-9]{1,78}$"
                  },
                  "expectedMultiplierNonce": {
                    "type": "string",
                    "pattern": "^[0-9]{1,78}$"
                  },
                  "operationDigest": {
                    "type": "string"
                  },
                  "signature": {
                    "type": "string"
                  },
                  "signer": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{40}$"
                  },
                  "validAfter": {
                    "type": "string"
                  },
                  "validUntil": {
                    "type": "string"
                  },
                  "verifyingContract": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{40}$"
                  },
                  "chainId": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "schemaVersion",
                  "receiptId",
                  "caller",
                  "target",
                  "asset",
                  "wrapper",
                  "actionType",
                  "recipient",
                  "amount",
                  "expectedMultiplierNonce",
                  "operationDigest",
                  "signature",
                  "signer",
                  "validAfter",
                  "validUntil",
                  "verifyingContract",
                  "chainId"
                ]
              }
            },
            "required": [
              "decision",
              "requestId",
              "evaluatedAt",
              "reasonCodes",
              "evidence",
              "operationDigest",
              "receipt"
            ]
          },
          {
            "type": "object",
            "properties": {
              "decision": {
                "type": "string",
                "const": "BLOCK"
              },
              "requestId": {
                "type": "string"
              },
              "evaluatedAt": {
                "type": "string"
              },
              "reasonCodes": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "reasonExplanations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "explanation": {
                      "type": "string"
                    }
                  },
                  "required": ["code", "explanation"]
                }
              },
              "evidence": {
                "type": "object",
                "properties": {
                  "apiEvidenceAgeMs": {
                    "type": ["number", "null"]
                  },
                  "chainEvidenceAgeMs": {
                    "type": ["number", "null"]
                  },
                  "evidenceIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "blockNumber": {
                    "type": ["string", "null"]
                  },
                  "blockHash": {
                    "type": ["string", "null"]
                  }
                },
                "required": [
                  "apiEvidenceAgeMs",
                  "chainEvidenceAgeMs",
                  "evidenceIds",
                  "blockNumber",
                  "blockHash"
                ]
              },
              "operationDigest": {
                "type": "string"
              }
            },
            "required": [
              "decision",
              "requestId",
              "evaluatedAt",
              "reasonCodes",
              "reasonExplanations",
              "evidence",
              "operationDigest"
            ]
          }
        ]
      },
      "ReviewResolution": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 20,
            "maxLength": 2000
          },
          "evidenceIds": {
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        },
        "required": ["reason", "evidenceIds"],
        "additionalProperties": false
      }
    }
  },
  "paths": {
    "/v1/health/live": {
      "get": {
        "tags": ["health"],
        "summary": "Process liveness. Does not depend on the database.",
        "responses": {
          "200": {
            "description": "The process is running.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/health/ready": {
      "get": {
        "tags": ["health"],
        "summary": "Dependency readiness. Reports real reachability, never a hard-coded value.",
        "responses": {
          "200": {
            "description": "Every mandatory dependency is reachable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "A mandatory dependency is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/assets": {
      "get": {
        "tags": ["evidence"],
        "summary": "List discovered assets with lifecycle state, canonicality, and evidence freshness.",
        "description": "Keyset pagination. Offset pagination would silently skip or repeat rows as projections update underneath a paging client, which for an evidence console means an asset in a bad state could scroll past unseen. Every response carries servedAt.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Opaque; from a prior nextCursor."
          },
          {
            "name": "lifecycleState",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "canonicality",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["PASS", "FAIL", "UNKNOWN"]
            }
          },
          {
            "name": "staleEvidence",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "True selects stale or missing evidence; false selects fresh evidence."
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 64
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of assets."
          },
          "400": {
            "description": "An unrecognised filter is rejected rather than ignored.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/assets/{assetId}": {
      "get": {
        "tags": ["evidence"],
        "summary": "One asset with its current canonicality and evidence provenance.",
        "parameters": [
          {
            "name": "assetId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The asset."
          },
          "404": {
            "description": "No such asset. An empty shell is never returned in its place.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/assets/{assetId}/timeline": {
      "get": {
        "tags": ["evidence"],
        "summary": "Replay one asset from immutable journal events.",
        "parameters": [
          {
            "name": "assetId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "upToEventId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Journal events and deterministic replay metadata."
          },
          "400": {
            "description": "Invalid or unrecognised timeline query parameters.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such asset.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/system/version": {
      "get": {
        "tags": ["health"],
        "summary": "Build provenance and the enforcement boundary.",
        "description": "Reports the git SHA and build time from build-time environment. Absent values are reported as \"unknown\" rather than invented — a wrong commit hash sends an investigation to the wrong code.",
        "responses": {
          "200": {
            "description": "Version metadata."
          }
        }
      }
    },
    "/v1/system/coverage": {
      "get": {
        "tags": ["evidence"],
        "summary": "The four coverage metrics, counted in one pass so they are mutually consistent.",
        "responses": {
          "200": {
            "description": "Coverage counts."
          }
        }
      }
    },
    "/v1/system/source-health": {
      "get": {
        "tags": ["evidence"],
        "summary": "Per-source health with last success and last failure instants.",
        "responses": {
          "200": {
            "description": "Source health."
          }
        }
      }
    },
    "/v1/incidents": {
      "get": {
        "tags": ["evidence"],
        "summary": "Open and resolved incidents, ordered by deterministic severity then recency.",
        "description": "Severity is a deterministic category. There is no numeric or model-generated risk score.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["OPEN", "IN_REVIEW", "RESOLVED", "RECOVERED"]
            }
          },
          {
            "name": "assetId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Incidents."
          }
        }
      }
    },
    "/v1/preflight": {
      "post": {
        "tags": ["preflight"],
        "summary": "Authorize one exact operation, or refuse it.",
        "description": "Returns ALLOW with a short-lived EIP-712 receipt bound to this exact operation, or BLOCK with stable reason codes and NO receipt. A receipt is never returned for a BLOCK, for degraded evidence, or for an UNKNOWN check. An Idempotency-Key header is mandatory: a retried preflight must not mint a second receipt for the same intent.",
        "security": [
          {
            "apiKey": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PreflightRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "An ALLOW with a receipt, or a BLOCK with reason codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreflightResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request, or a missing Idempotency-Key.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed. The body is identical for every failure reason.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "The key lacks the integrator:preflight scope.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "The idempotency key is in progress or was reused for a different request.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/incidents/{incidentId}/review-resolution": {
      "post": {
        "tags": ["operator"],
        "summary": "Record an operator resolution. Does not resume protected actions.",
        "description": "A resolution records a decision with an actor, a specific reason, and an evidence reference. It cannot create source agreement: the response always reports protectedActionsResumed=false, and protected actions remain governed by current evidence.",
        "security": [
          {
            "apiKey": []
          }
        ],
        "parameters": [
          {
            "name": "incidentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewResolution"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Recorded. Protected actions are not resumed."
          },
          "400": {
            "description": "A specific reason and an evidence reference are mandatory.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "The key lacks the operator:review scope.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such incident.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "The incident was already resolved.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  }
}
