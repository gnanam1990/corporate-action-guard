{
  "name": "@cag/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify HTTP API for Corporate Action Guard.",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc --build",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "openapi": "tsc --build && node dist/write-openapi.js"
  },
  "dependencies": {
    "@cag/config": "workspace:*",
    "@cag/db": "workspace:*",
    "@cag/domain": "workspace:*",
    "@cag/observability": "workspace:*",
    "@cag/receipts": "workspace:*",
    "@cag/reconciler": "workspace:*",
    "@cag/xlayer-reader": "workspace:*",
    "@cag/xstocks-client": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "fastify": "^5.12.1",
    "pg": "^8.23.0",
    "viem": "^2.56.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
