#
# The console.
#
# Separate from the API image for one reason that matters: this container must NEVER
# receive the receipt signer key, the database URL, or an operator secret. Keeping the
# images apart makes that a deployment fact rather than a review comment.

FROM node:22-alpine AS deps
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/web/package.json apps/web/
RUN pnpm install --frozen-lockfile --filter @cag/web... --ignore-scripts

FROM deps AS build
WORKDIR /app
COPY apps/web/ apps/web/

# The ONLY variable the browser bundle may contain. Anything else with this prefix is
# rejected by packages/config at startup, and the bundle is scanned after the build.
ARG NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}

RUN pnpm --filter @cag/web build

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup -S guard && adduser -S -G guard guard

COPY --from=build --chown=guard:guard /app/node_modules ./node_modules
COPY --from=build --chown=guard:guard /app/apps/web ./apps/web
COPY --from=build --chown=guard:guard /app/package.json ./package.json

USER guard
EXPOSE 3000
WORKDIR /app/apps/web
CMD ["../../node_modules/.bin/next", "start", "--port", "3000"]
