{
  "name": "corporate-action-guard",
  "version": "0.1.0",
  "private": true,
  "description": "Fail-closed preflight guard that stops integrations acting on stale xStocks corporate-action state on X Layer.",
  "license": "MIT",
  "engines": {
    "node": ">=22.11.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . && cd contracts && forge fmt",
    "format:check": "prettier --check . && cd contracts && forge fmt --check",
    "typecheck": "tsc --build --verbose",
    "test": "tsc --build && vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "tsc --build && vitest run --project integration",
    "test:contracts": "cd contracts && forge test -vv",
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm -r --filter \"./apps/*\" build",
    "build:contracts": "cd contracts && forge build",
    "dev": "pnpm -r --parallel dev",
    "db:migrate": "pnpm --filter @cag/db migrate",
    "db:backup": "node scripts/backup-database.mjs",
    "db:restore-drill": "node scripts/restore-drill.mjs",
    "arch:check": "node scripts/check-layering.mjs",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "verify": "pnpm format:check && pnpm lint && pnpm arch:check && pnpm typecheck && pnpm check:contrast && pnpm check:compose && pnpm check:monitoring && pnpm check:deps && pnpm scan:secrets && pnpm docs:check && pnpm test && pnpm test:contracts",
    "scan:bundle": "node scripts/scan-web-bundle.mjs",
    "test:mutation": "node scripts/mutate-preflight.mjs",
    "format:sol": "cd contracts && forge fmt",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "docs:readiness": "node scripts/generate-readiness.mjs",
    "docs:check": "node scripts/generate-readiness.mjs --check",
    "audit:deps": "node scripts/dependency-audit.mjs",
    "testnet:status": "node scripts/testnet-status.mjs",
    "testnet:deploy": "bash scripts/testnet-deploy.sh",
    "testnet:prove": "node scripts/testnet-prove.mjs",
    "fixture:evidence:publish": "pnpm --filter @cag/domain build && node scripts/publish-fixture-evidence.mjs",
    "signer:kms-address": "pnpm --filter @cag/receipts kms:address",
    "api-key:generate": "node scripts/generate-api-key.mjs",
    "check:compose": "node scripts/check-compose-secrets.mjs",
    "check:monitoring": "node scripts/check-monitoring-config.mjs",
    "check:deps": "node scripts/check-runtime-deps.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "viem": "^2.56.3",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
}
